{
  "name": "lmsplusv2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && biome check .claude",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "check-types": "turbo run check-types",
    "e2e": "turbo run e2e",
    "knip": "knip",
    "supabase": "pnpm dlx supabase@2.78.1",
    "lint:ci": "node .claude/hooks/run-ci-lint.mjs",
    "db:types": "pnpm -s supabase gen types typescript --local > packages/db/src/types.ts.tmp && mv packages/db/src/types.ts.tmp packages/db/src/types.ts || { rm -f packages/db/src/types.ts.tmp; exit 1; }; biome format --write packages/db/src/types.ts",
    "tokens:css": "pnpm --filter @repo/web tokens:css",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.30.1 <8",
      "brace-expansion@5": ">=5.0.11 <6",
      "zod": "^4.6.6",
      "fast-uri": ">=3.1.9 <4",
      "source-map-js": ">=1.2.2 <2",
      "ip-address": ">=10.7.4 <11",
      "postcss": ">=8.5.23 <9",
      "esbuild": ">=0.28.1 <0.29",
      "js-yaml": ">=4.3.2 <5",
      "next": ">=16.4.2 <16.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "zod": "^4.6.6"
  }
}
