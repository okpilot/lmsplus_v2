or {
  `function $name($props) { $body }`,
  `const $name = ($props) => $body`
} where {
  $name <: r"^[A-Z].*",
  $props <: r"(?s).+",
  $props <: not r"(?s).*Readonly<.*",
  register_diagnostic(span=$name, message="Component props must be wrapped in Readonly<...> (code-style.md section 5)", severity="error")
}
