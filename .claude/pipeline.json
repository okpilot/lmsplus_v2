{
  "_": "Single source of truth for pipeline facts that .claude/pipeline.test.mjs VALIDATES. Every FACT here is asserted by that test (this `_` field is documentation, not a fact) — nothing is recorded that is not checked, so proximity to a green suite never implies coverage. Prose explains WHY; it must not restate a value from here. Rationale: git history of docs/decisions.md (Decision 62, #1268).",

  "models": {
    "sonnet": "sonnet",
    "haiku": "haiku",
    "opus": "claude-opus-5-5"
  },

  "baseTools": ["Read", "Glob", "Grep", "Bash"],
  "writeTools": ["Write", "Edit"],
  "skillTools": ["Skill"],

  "agents": {
    "code-reviewer": {
      "model": "sonnet",
      "write": false,
      "role": "gate-round"
    },
    "semantic-reviewer": {
      "model": "sonnet",
      "write": false,
      "role": "gate-round"
    },
    "doc-updater": {
      "model": "haiku",
      "write": false,
      "role": "gate-round"
    },
    "test-writer": {
      "model": "sonnet",
      "write": true,
      "role": "gate-round"
    },
    "deletion-reviewer": {
      "model": "sonnet",
      "write": false,
      "role": "gate-round"
    },
    "red-team": { "model": "sonnet", "write": false, "role": "conditional" },
    "coderabbit-sync": {
      "model": "haiku",
      "write": false,
      "role": "conditional"
    },
    "plan-critic": {
      "model": "sonnet",
      "write": false,
      "role": "pre-execution"
    },
    "implementation-critic": {
      "model": "sonnet",
      "write": false,
      "role": "gate-round"
    },
    "code-review-skill": {
      "model": "opus",
      "write": false,
      "role": "gate-round",
      "skill": true
    },
    "security-auditor": { "model": "sonnet", "write": false, "role": "pre-push" }
  },

  "order": ["gate-round", "fix-loop", "conditional", "spec-tasks"],

  "hooks": {
    "pre-commit": [
      "biome-check",
      "file-size-guard",
      "prose-claims",
      "prose-paths",
      "md-allowlist",
      "soft-delete-guard",
      "test-title-leakage",
      "type-check"
    ],
    "commit-msg": ["claim-check", "commitlint", "decisions-ledger", "retracted-phrase"],
    "pre-push": ["audit", "security-auditor"]
  },

  "securityPaths": [
    "supabase/migrations/**",
    "packages/db/src/**",
    "apps/web/app/app/quiz/actions/**",
    "apps/web/app/auth/**",
    "apps/web/proxy.ts",
    "docs/security.md"
  ],
  "redTeamExtraPaths": ["apps/web/e2e/redteam/**"],

  "coderabbitSyncTriggers": [
    ".claude/rules/code-style.md",
    ".claude/rules/security.md",
    "docs/security.md",
    "biome.json",
    "CLAUDE.md",
    ".claude/hooks/*.mjs"
  ],

  "modelLiteralSites": [
    { "path": ".claude/hooks/run-security-auditor.sh", "flag": "--model", "expects": "sonnet" },
    { "path": ".github/workflows/claude-review.yml", "flag": "--model", "expects": "opus" }
  ],

  "guards": {
    "_": "Every guard wired into lefthook.yml, any .github/workflows/*.yml step (a `.claude/...` path not passed to `node --test`), or any .claude/settings.json hook event must carry a spawned, graded RED and GREEN control (code-style.md §7). .claude/controls.test.mjs derives the wired set and checks it against these keys in BOTH directions, then checks each non-exempt entry's `suites` for a linked CONTROL: red and CONTROL: green test. `base` names the co-located `.claude/hooks/<base>.mutations.json` carrying the `<base>-always-passes` / `<base>-always-blocks` grading entries.",
    ".claude/hooks/check-soft-delete-guard.mjs": {
      "base": "check-soft-delete-guard",
      "suites": [".claude/hooks/check-soft-delete-guard.test.mjs"]
    },
    ".claude/hooks/check-file-size-guard.mjs": {
      "base": "check-file-size-guard",
      "suites": [
        ".claude/hooks/check-file-size-guard.test.mjs",
        ".claude/hooks/check-file-size-guard.args.test.mjs",
        ".claude/hooks/check-file-size-guard.cli.test.mjs",
        ".claude/hooks/check-file-size-guard.trailer.test.mjs",
        ".claude/hooks/check-file-size-guard.update.test.mjs",
        ".claude/hooks/check-file-size-guard.directive.test.mjs"
      ]
    },
    ".claude/hooks/check-test-title-leakage.mjs": {
      "base": "check-test-title-leakage",
      "suites": [
        ".claude/hooks/check-test-title-leakage.test.mjs",
        ".claude/hooks/check-test-title-leakage.repo.test.mjs"
      ]
    },
    ".claude/hooks/check-prose-claims.mjs": {
      "base": "check-prose-claims",
      "suites": [
        ".claude/hooks/check-prose-claims.test.mjs",
        ".claude/hooks/check-prose-claims.repo.test.mjs"
      ]
    },
    ".claude/hooks/check-prose-paths.mjs": {
      "base": "check-prose-paths",
      "suites": [
        ".claude/hooks/check-prose-paths.test.mjs",
        ".claude/hooks/check-prose-paths.repo.test.mjs"
      ]
    },
    ".claude/hooks/check-md-allowlist.mjs": {
      "base": "check-md-allowlist",
      "suites": [
        ".claude/hooks/check-md-allowlist.test.mjs",
        ".claude/hooks/check-md-allowlist.repo.test.mjs"
      ]
    },
    ".claude/hooks/check-commit-claims.mjs": {
      "base": "check-commit-claims",
      "suites": [
        ".claude/hooks/check-commit-claims.test.mjs",
        ".claude/hooks/check-commit-claims.controls.test.mjs"
      ]
    },
    ".claude/hooks/check-retracted-phrase.mjs": {
      "base": "check-retracted-phrase",
      "suites": [
        ".claude/hooks/check-retracted-phrase.test.mjs",
        ".claude/hooks/check-retracted-phrase.repo.test.mjs",
        ".claude/hooks/check-retracted-phrase.base.test.mjs",
        ".claude/hooks/check-retracted-phrase.paths.test.mjs",
        ".claude/hooks/check-retracted-phrase.color.test.mjs"
      ]
    },
    ".claude/hooks/check-decisions-ledger.mjs": {
      "base": "check-decisions-ledger",
      "suites": [
        ".claude/hooks/check-decisions-ledger.test.mjs",
        ".claude/hooks/check-decisions-ledger.repo.test.mjs",
        ".claude/hooks/check-decisions-ledger.base.test.mjs",
        ".claude/hooks/check-decisions-ledger.range.test.mjs",
        ".claude/hooks/check-decisions-ledger.range-pure.test.mjs",
        ".claude/hooks/check-decisions-ledger.range-hint.test.mjs"
      ]
    },
    ".claude/hooks/guard-bash.js": {
      "base": "guard-bash",
      "suites": [".claude/hooks/guard-bash.test.mjs"]
    },
    ".claude/hooks/guard-agent-brief.js": {
      "base": "guard-agent-brief",
      "suites": [".claude/hooks/guard-agent-brief.test.mjs"]
    },
    ".claude/hooks/review-gate.js": {
      "base": "review-gate",
      "suites": [".claude/hooks/review-gate.test.mjs"]
    },
    ".claude/pipeline.test.mjs": {
      "base": "pipeline",
      "suites": [".claude/pipeline.repo.test.mjs"]
    },
    ".claude/controls.test.mjs": {
      "base": "controls",
      "suites": [".claude/controls.repo.test.mjs"]
    },
    ".claude/hooks/run-security-auditor.sh": {
      "base": "run-security-auditor",
      "suites": [
        ".claude/hooks/run-security-auditor.controls.test.mjs",
        ".claude/hooks/run-security-auditor.config.test.mjs",
        ".claude/hooks/run-security-auditor.prompt-config.test.mjs"
      ]
    },
    ".claude/hooks/on-stop.sh": {
      "exempt": "Stop hook; always exits 0 (toast notification only, its powershell.exe call is `|| true`) — cannot block"
    },
    ".claude/hooks/run-mutations.mjs": {
      "exempt": "a grader, not a blocking guard"
    }
  }
}
