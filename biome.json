{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/*.lock",
      "!**/pnpm-lock.yaml",
      "!**/.turbo",
      "!**/next-env.d.ts",
      "!**/app/tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use Button from @/components/ui/button."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      },
      "style": {
        "useConst": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@repo/db/test-helpers": "test-helpers wraps the service-role key (getAdminClient). Import it only from integration tests or a lib/integration-support/** dir \u2014 never production code (#925)."
            },
            "patterns": [
              {
                "group": ["next/dist/**"],
                "message": "Import from public next/* entry points."
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "noRestrictedElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.integration.test.ts",
        "**/lib/integration-support/**",
        "**/e2e/**",
        "**/__integration__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next/dist/**"],
                    "message": "Import from public next/* entry points."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/components/ui/**",
        "apps/web/app/app/admin/exam-config/_components/subject-config-card.tsx",
        "apps/web/app/app/_components/answer-options.tsx",
        "apps/web/app/app/dashboard/_components/info-tooltip.tsx",
        "apps/web/app/app/progress/_components/subject-breakdown.tsx",
        "apps/web/app/app/quiz/_components/question-filter-toggles.tsx",
        "apps/web/app/app/quiz/_components/question-grid-squares.tsx",
        "apps/web/app/app/quiz/_components/subject-select.tsx",
        "apps/web/app/app/quiz/session/_components/keyboard-legend.tsx",
        "apps/web/app/app/quiz/session/_components/ordering-input-item.tsx",
        "apps/web/components/sortable-table-head.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/globals.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/e2e/**",
        "**/__integration__/**",
        "**/lib/integration-support/**",
        "apps/web/scripts/**",
        ".claude/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**/*.tsx", "!**/*.test.tsx", "!**/*.spec.tsx"],
      "plugins": ["./biome-plugins/readonly-props.grit"]
    },
    {
      "includes": ["**/app/**/route.ts", "**/app/**/route.tsx", "**/app/**/route.js"],
      "plugins": ["./biome-plugins/no-mutation-route.grit"]
    }
  ]
}
